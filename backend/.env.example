PORT=5003
NODE_ENV=development

# MongoDB
MONGO_URI_ATLAS=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI_STUDENT_PORTAL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-strong-secret

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=HAU Portal <noreply@hau.edu.ph>
