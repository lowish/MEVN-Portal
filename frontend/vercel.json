{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/**": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "^/api/.*",
      "continue": true
    },
    {
      "src": "/assets/.*",
      "continue": true
    },
    {
      "src": ".*",
      "dest": "/index.html"
    }
  ]
}
